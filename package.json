{
  "name": "emanyzwww-doc-site",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "个人站点：VitePress 1.6.4 + TypeScript + 自定义主题",
  "scripts": {
    "dev": "vitepress dev . --host 127.0.0.1 --port 5173",
    "build": "vitepress build .",
    "preview": "vitepress preview .",
    "clean": "tsx scripts/run.ts clean",
    "new": "tsx scripts/run.ts new",
    "posts": "tsx scripts/run.ts posts",
    "list": "tsx scripts/run.ts posts",
    "check": "tsx scripts/run.ts check",
    "fix": "tsx scripts/run.ts fix",
    "stats": "tsx scripts/run.ts stats",
    "tags": "tsx scripts/run.ts tags",
    "guide": "tsx scripts/run.ts --help",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "oxlint .vitepress docs scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "oxfmt --write docs .vitepress scripts README.md WRITING.md DEVELOPING.md DESIGN.md --ignore-path .oxfmtignore",
    "format:check": "oxfmt --check docs .vitepress scripts README.md WRITING.md DEVELOPING.md DESIGN.md --ignore-path .oxfmtignore"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.13.1",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.1.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.89.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitepress": "1.6.4",
    "vitest": "^5.0.5",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.18.0"
}
