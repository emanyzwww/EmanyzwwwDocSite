{
  "name": "emanyzwww-doc-site",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "个人站点：VitePress 1.6.4 + TypeScript + 自定义主题",
  "scripts": {
    "dev": "vitepress dev . --host 127.0.0.1 --port 5173",
    "build": "vitepress build .",
    "preview": "vitepress preview .",
    "doc": "tsx scripts/doc.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "oxlint .vitepress docs scripts",
    "format": "oxfmt --write docs .vitepress scripts README.md WRITING.md DEVELOPING.md DESIGN.md --ignore-path .oxfmtignore",
    "format:check": "oxfmt --check docs .vitepress scripts README.md WRITING.md DEVELOPING.md DESIGN.md --ignore-path .oxfmtignore"
  },
  "devDependencies": {
    "@clack/prompts": "1.8.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.13.1",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.1.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "sharp": "0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitepress": "1.6.4",
    "vue": "^3.5.45",
    "vue-tsc": "^2.2.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.18.0"
}
