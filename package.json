{
  "name": "emanyzwww-doc-site",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "个人站点：VitePress 1.6.4 + TypeScript + 自定义主题",
  "scripts": {
    "dev": "vitepress dev . --host 127.0.0.1 --port 5173",
    "build": "vitepress build .",
    "preview": "vitepress preview .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "oxlint .vitepress docs",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "oxfmt --write docs .vitepress README.md WRITING.md DEVELOPING.md --ignore-path .oxfmtignore",
    "format:check": "oxfmt --check docs .vitepress README.md WRITING.md DEVELOPING.md --ignore-path .oxfmtignore",
    "clean": "node -e \"for (const d of ['.vitepress/dist','.vitepress/cache','.vitepress/.temp']) require('fs').rmSync(d,{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.13.1",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.1.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^5.7.3",
    "vitepress": "1.6.4",
    "vitest": "^5.0.5",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.18.0"
}
