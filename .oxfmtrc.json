{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "bracketSameLine": true,
  "bracketSpacing": true,
  "embeddedLanguageFormatting": "auto",
  "endOfLine": "lf",
  "ignorePatterns": [
    ".codex/**",
    ".idea/**",
    "**/dist/**",
    "**/node_modules/**",
    "public/**",
    "resources/**",
    "static/**",
    "layouts/**",
    ".dsh/**"
  ],
  "insertFinalNewline": true,
  "jsdoc": true,
  "printWidth": 100,
  "quoteProps": "as-needed",
  "semi": false,
  "singleAttributePerLine": true,
  "singleQuote": true,
  "sortImports": true,
  "sortPackageJson": true,
  "sortTailwindcss": true,
  "tabWidth": 2,
  "useTabs": false,
  "overrides": [
    {
      "files": ["**/*.md", "**/*.markdown"],
      "options": {
        "printWidth": 120,
        "proseWrap": "preserve",
        "embeddedLanguageFormatting": "off"
      }
    },
    {
      "files": ["**/*.yaml", "**/*.yml"],
      "options": {
        "printWidth": 100,
        "proseWrap": "preserve"
      }
    }
  ]
}
